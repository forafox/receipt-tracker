BOT_TOKEN=
BOT_TIMEZONE=Europe/Moscow
BOT_DATABASE_PATH=receipts.sqlite

# Optional OpenKilo receipt parser. Leave empty to use the deterministic parser only.
KILO_API_KEY=

# Local Ollama receipt reviewer (model must be pulled with `ollama pull`).
OLLAMA_HOST=http://localhost:11434
OCR_REVIEW_MODEL=qwen2.5:1.5b-instruct-q4_K_M
M3_VALIDATION_MODEL=qwen2.5:1.5b-instruct-q4_K_M

OCR_ENGINE=tesseract
OCR_TESSERACT_LANGUAGES=rus+eng
OCR_EASYOCR_LANGUAGES=["ru","en"]
OCR_MIN_CONFIDENCE=0.0
OCR_GPU=false
OCR_TESSERACT_CONFIG=
OCR_ADAPTIVE=true
OCR_ADAPTIVE_PSM_MODES=[3,4,6]
OCR_QUALITY_CHECK_ENABLED=true
OCR_QUALITY_MIN_SHARPNESS=50.0
OCR_QUALITY_MIN_CONTRAST=20.0
OCR_QUALITY_MAX_GLARE_RATIO=0.35
OCR_POSTPROCESS_ENABLED=true
OCR_POSTPROCESS_MIN_BOX_AREA=9.0
OCR_POSTPROCESS_NMS_IOU=0.5
